# =============================================================================
# Snailpay API: environment variables
# Copy to .env and fill in. NEVER commit .env (keep it in .gitignore).
# Spring does not read .env by itself: load it in your IntelliJ run
# configuration (EnvFile plugin or "Environment variables" file).
# Comments are on their own lines on purpose: many .env loaders treat a
# trailing "# comment" as part of the value.
# =============================================================================


# -----------------------------------------------------------------------------
# Database (Postgres)
# Used by the R2DBC connection and by Flyway (migrations use a JDBC URL built
# from the same values).
# -----------------------------------------------------------------------------
# Database name, for example snailpay
POSTGRES_DB=
# Database user, for example postgres
POSTGRES_USER=
# That user's password
POSTGRES_PASSWORD=
# For example localhost
POSTGRES_HOST=
# For example 5432
POSTGRES_PORT=


# -----------------------------------------------------------------------------
# App profile and verification
# -----------------------------------------------------------------------------
# Use "dev" locally. It turns on the dev-only helpers: LoggingSmsSender and
# LoggingEmailSender print codes and links in the console instead of sending
# them, and DevCurrentCustomerProvider trusts the X-Dev-External-Id header.
# Never use "dev" in a deployed environment.
SPRING_PROFILES_ACTIVE=

# Secret used to hash the 6-digit phone codes (HMAC).
# Generate with: openssl rand -base64 32
VERIFICATION_HMAC_SECRET=

# Where the frontend runs. Used to build the link in the verification email
# (FRONTEND_BASE_URL/verify-email?token=...). For example http://localhost:4200
FRONTEND_BASE_URL=


# -----------------------------------------------------------------------------
# Email (SMTP)
# Not used in dev (LoggingEmailSender prints the link instead), but Spring
# still has to resolve these placeholders at startup, so they need a value.
# In production, point them at a real provider (SES, Postmark, SendGrid...).
# -----------------------------------------------------------------------------
# For example localhost in dev
MAIL_HOST=
# For example 587
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=


# -----------------------------------------------------------------------------
# KYC: AWS S3 + KMS (created in AWS-SETUP.md)
# Identity documents go to the bucket. The SSN and ID number are encrypted with
# the KMS key before they reach the database.
# -----------------------------------------------------------------------------
# Private S3 bucket for ID documents
KYC_BUCKET=
# Region of the bucket and key, for example us-east-1
AWS_REGION=
# Full ARN of the KMS key, starts with arn:aws:kms:
KYC_KMS_KEY_ARN=

# Separate secret for detecting the same SSN on two accounts (HMAC blind
# index). Generate with: openssl rand -base64 32
# Do NOT reuse VERIFICATION_HMAC_SECRET.
KYC_TIN_INDEX_SECRET=

# AWS credentials: the SDK reads this named profile from ~/.aws, for example
# snailpay-dev. Alternatively, delete this line and set AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY instead.
AWS_PROFILE=